# Copiar a /etc/piflix.env (chmod 600). No subir el archivo real al repositorio.
PORT=8080
MEDIA_ROOT=/mnt/storage
CACHE_DIR=/mnt/storage/.piflix-cache
STATIC_DIR=/opt/piflix/static
# Clave de TMDB (carátulas y sinopsis). Opcional.
TMDB_API_KEY=
TMDB_LANG=es-MX
# Clave de administrador (mínimo 12 caracteres). Sin ella, descargas, subidas y ediciones quedan desactivadas.
ADMIN_TOKEN=
